{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "dezog",
      "request": "launch",
      "name": "Z80 Unit Tests (zsim)",
      "unitTests": true,
      "presentation": {
        "hidden": false
      },
      "preLaunchTask": "Build Unit Tests ${input:testTarget}",
      "remoteType": "zsim",
      "zsim": {
        "memoryModel": "RAM",
        "visualMemory": true,
        "cpuFrequency": 20000000
      },
      "z88dkv2": [
        {
          "path": "Main Board v2.0/Source/CPU/test/.build/${input:testTarget}/**/*.lis",
          "mapFile": "Main Board v2.0/Source/CPU/test/.build/${input:testTarget}/unittests.map",
          "srcDirs": [
            "Main Board v2.0/Source/CPU"
          ]
        }
      ],
      "loadObjs": [
        {
          "path": "Main Board v2.0/Source/CPU/test/.build/${input:testTarget}/unittests.bin",
          "start": "0x8000"
        }
      ],
      "rootFolder": "${workspaceFolder}",
      "startAutomatically": false,
      "history": {
        "codeCoverageEnabled": true
      },
      "unitTestTimeout": 5
    }
  ],
  "inputs": [
    {
      "id": "testTarget",
      "type": "pickString",
      "description": "Test target to run",
      "options": [
        "lib",
        "os"
      ],
      "default": "lib"
    }
  ]
}
