{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Docs",
      "type": "shell",
      "command": "& '${workspaceFolder}/Main Board v2.0/Source/CPU/tools/build.ps1'",
      "args": ["-Target", "docs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build Unit Tests lib",
      "type": "shell",
      "command": "& '${workspaceFolder}/Main Board v2.0/Source/CPU/tools/build_test.ps1' -Target lib",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build Unit Tests os",
      "type": "shell",
      "command": "& '${workspaceFolder}/Main Board v2.0/Source/CPU/tools/build_test.ps1' -Target os",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build All Unit Tests",
      "type": "shell",
      "command": "& '${workspaceFolder}/Main Board v2.0/Source/CPU/tools/build_test.ps1'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
